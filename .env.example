SERVER_PORT=8080
# Public base URL the monolith puts in confirmation links it emails to users.
BASE_URL=http://localhost:8080
# Message broker the monolith publishes notification commands to, and the
# notifier consumes them from. Use localhost for a bare run; Compose overrides
# this per service with the in-network broker hostname.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=release_notifier
DB_SSLMODE=disable

GITHUB_TOKEN=

SCAN_INTERVAL=5m

# How long the subscribe saga waits for the confirmation outcome before the
# reaper compensates a stranded subscription.
SAGA_TIMEOUT=30s

# Required. Startup fails when unset/empty so a config mistake cannot expose
# /api/subscriptions to the public internet.
API_KEY=change-me

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=10m

TRUSTED_PROXY=false
LOG_LEVEL=info
SERVICE_NAME=github-release-notifier

# Notification service env (docker-compose sets these on the notifier); for a bare-process run set notifier DB_* so it does not migrate the monolith DB:
#   DB_HOST=localhost DB_PORT=5434 DB_NAME=notification
# The notifier also reads RABBITMQ_URL (above) to consume notification commands.
GRPC_ADDR=:50051
# REST verify-email endpoint (HW10): the gRPC migration kept this HTTP/JSON
# transport alongside for comparison. POST /api/v1/verify-email.
REST_ADDR=:8081
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Per-message SMTP delivery timeout. Bounds the broker-consumer path, whose
# context has no request deadline, so a stalled server cannot hang the consumer.
SMTP_TIMEOUT=30s
